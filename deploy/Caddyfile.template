# Caddy configuration for quidam. deploy.sh copies this file to /etc/caddy/Caddyfile,
# with __DOMAIN__ replaced by your domain (set in deploy/config.sh).
#
# What Caddy does here:
# - gets and renews free HTTPS certificates by itself (Let's Encrypt or ZeroSSL), for every
#   name listed below; nothing to do by hand, ever;
# - redirects every http:// request to https:// by itself;
# - passes each request to the quidam Node process, which listens only on 127.0.0.1:8080.
#
# Access logs: Caddy writes NO access log unless a `log` directive is added to a site block.
# There is none on purpose: the visitors' IP addresses are never written to disk.
# Do not add one.

# Global options (this unnamed block applies to the whole server).
{
	servers {
		timeouts {
			# A client gets 10 s to send its request headers (stops slow "slowloris" clients).
			read_header 10s
			# An idle kept-alive connection is closed after 2 minutes.
			idle 2m
		}
	}
}

# The site itself, plus the two helper names used by the IPv4/IPv6 check:
# v4.__DOMAIN__ must have only an A record (IPv4), v6.__DOMAIN__ only an AAAA record (IPv6).
__DOMAIN__, v4.__DOMAIN__, v6.__DOMAIN__ {
	# Send everything to Node. Caddy adds X-Forwarded-For with the visitor's real address.
	# Because no `trusted_proxies` is configured, Caddy ignores any X-Forwarded-For the visitor
	# sends and writes only the address it sees, so the visitor cannot pretend to be someone else.
	# Node (TRUST_PROXY=127.0.0.1,::1) reads the right-most entry, which is this one.
	reverse_proxy 127.0.0.1:8080

	# Do not advertise the server software.
	header -Server
}

# www.yourdomain goes to the bare domain, keeping the path.
www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}
