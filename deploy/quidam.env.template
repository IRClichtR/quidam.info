# quidam settings on the server. deploy.sh installs this as /etc/quidam/quidam.env,
# with __DOMAIN__ replaced. Every variable is explained in README.md, "Configuration".
NODE_ENV=production
# Node listens only on this machine; Caddy, in front, faces the internet.
HOST=127.0.0.1
PORT=8080
# STUN is plain UDP and does not go through Caddy: Node answers it directly on every address.
STUN_PORT=3478
SITE_ORIGIN=https://__DOMAIN__
V4_ORIGIN=https://v4.__DOMAIN__
V6_ORIGIN=https://v6.__DOMAIN__
# Caddy runs on this machine: only its requests have their X-Forwarded-For read.
TRUST_PROXY=127.0.0.1,::1
LEAKCHECK_DATA_DIR=/var/lib/quidam
